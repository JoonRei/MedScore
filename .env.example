# MedScores V1.3
# Get these from the Supabase project's Connect dialog / Settings > API Keys.

# IMPORTANT: this must be the PROJECT BASE URL only.
# Correct: https://abcdefghijklmnopqrst.supabase.co
# Do NOT add /rest/v1, /auth/v1, /dashboard, or any other path.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key. New projects should use the publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Legacy alternative:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxx

# Server-only elevated key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# Legacy alternative:
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxx

# Only this authenticated Supabase user can access Admin pages and Admin APIs.
ADMIN_EMAIL=your-admin-email@example.com

# V4.21 device notifications (Web Push). Generate once with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_VAPID_KEY
VAPID_SUBJECT=mailto:your-admin-email@example.com
